% Shared settings of the paper's figures: fonts, colours and the label language.
% The French build of a figure (x.fr.tex) defines \figfr and then reads x.tex.
\usepackage{fontspec}
\setmainfont{LibertinusSans}[Extension=.otf,UprightFont=*-Regular,BoldFont=*-Bold,ItalicFont=*-Italic]
% Numbers and symbols in labels use the paper's math font, not the TeX default.
\usepackage{unicode-math}
\setmathfont{LibertinusMath-Regular.otf}
\usepackage{pgfplots,pgfplotstable}
\pgfplotsset{compat=1.18}
\usetikzlibrary{calc}
\usepgfplotslibrary{colormaps}
\definecolor{ink}{HTML}{00663D}
\definecolor{green}{HTML}{008751}
\definecolor{yellow}{HTML}{FCD116}
\definecolor{red}{HTML}{E8112D}
\definecolor{grey}{HTML}{8A8F98}
\newcommand{\T}[2]{\ifdefined\figfr #2\else #1\fi}
\pgfplotsset{every axis/.append style={font=\small, tick label style={font=\footnotesize},
  label style={font=\small}, axis line style={black!60}, tick style={black!60}},
  /pgf/number format/.cd, 1000 sep={\mbox{,}}}
\ifdefined\figfr\pgfkeys{/pgf/number format/.cd, use comma, 1000 sep={\mbox{\,}}}\fi
